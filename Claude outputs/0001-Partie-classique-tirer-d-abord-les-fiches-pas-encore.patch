 function shuffle(a,rand=Math.random){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(rand()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
+// Partie classique : fiches déjà vues gardées sur l'appareil, retirées en dernier ; vivier épuisé → on repart de zéro
+const SEEN={get(){try{return new Set(JSON.parse(localStorage.getItem('fa-vus'))||[])}catch(e){return new Set()}},set(s){try{localStorage.setItem('fa-vus',JSON.stringify([...s]))}catch(e){}}};
+function drawFresh(pool,n){
+  const seen=SEEN.get(), fresh=pool.filter(p=>!seen.has(p.id));
+  const picks=[...shuffle(fresh),...shuffle(pool.filter(p=>seen.has(p.id)))].slice(0,n);
+  if(fresh.length<n) pool.forEach(p=>seen.delete(p.id));
+  picks.forEach(p=>seen.add(p.id)); SEEN.set(seen); return picks;
+}
 
